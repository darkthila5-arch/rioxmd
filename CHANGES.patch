diff -ruN -x node_modules -x sessions -x package-lock.json orig/rioxmd-main/commands/mediatools.js rioxmd-main/commands/mediatools.js
--- a/commands/mediatools.js	1970-01-01 00:00:00.000000000 +0000
+++ b/commands/mediatools.js	2026-11-05 12:21:26.788797832 +0000
@@ -0,0 +1,201 @@
+// Media tools.
+//   .tomp3  (aliases .mp3 .toaudio)       video / voice note / audio  -> MP3          (.tomp3 doc = send it as a file)
+//   .topdf  (aliases .pdf .imgtopdf)      photos                      -> one PDF      (add photos one by one, then .topdf done)
+//   .ocr    (aliases .totext .imgtext)    photo with text             -> the text     (.ocr si / en / ta / si+en)
+// Use them by replying to the media, or send the media with the command as its caption.
+// The work is in lib/mediatools.js. Needs ffmpeg (MP3) and tesseract (OCR); both are in the Docker image.
+import { PREFIX } from '../lib/config.js';
+import { say } from '../lib/card.js';
+import { MAX_AUDIO_SECONDS, MAX_INPUT_BYTES, MAX_PDF_PAGES, DEFAULT_OCR_LANGS, OCR_NAMES, buildPdf, downloadMedia, findMedia, imageToPage, ocrImage, parseOcrLang, toMp3 } from '../lib/mediatools.js';
+
+const MB = (n) => Math.round(n / 1048576);
+const sizeOf = (part) => (typeof part?.fileLength?.toNumber === 'function' ? part.fileLength.toNumber() : Number(part?.fileLength || 0));
+
+function failText(err) {
+  if (err?.missing === 'ffmpeg') return '❌ ffmpeg is not installed on the server, so this command cannot work.';
+  if (err?.missing) return `❌ ${err.missing} is not installed on the server, so this command cannot work.`;
+  if (err?.noLang) return `❌ ${err.noLang.map((l) => OCR_NAMES[l] || l).join(' / ')} language data is not installed on this server.`;
+  if (err?.tooBig) return `❌ That file is bigger than ${MB(MAX_INPUT_BYTES)} MB.`;
+  if (err?.download) return '❌ Could not download that file. Forward it again and reply to the new one.';
+  if (err?.noAudio) return '❌ That file has no sound to convert.';
+  if (err?.badImage) return '❌ I could not read that picture. Try another one.';
+  return '❌ Could not convert that file. Try another one.';
+}
+
+// Same person can not start many heavy jobs in a row.
+const lastUse = new Map();
+setInterval(() => { const t = Date.now(); for (const [k, v] of lastUse) if (t - v > 60e3) lastUse.delete(k); }, 5 * 60e3).unref();
+function tooSoon(key, ms) {
+  const now = Date.now();
+  if (now - (lastUse.get(key) || 0) < ms) return true;
+  lastUse.set(key, now);
+  return false;
+}
+const whoKey = (sessionId, jid, msg) => `${sessionId}|${jid}|${msg.key?.fromMe ? 'me' : (msg.key?.participant || '')}`;
+
+/* ---------- .tomp3 ---------- */
+const tomp3 = {
+  name: 'tomp3', aliases: ['mp3', 'toaudio'], react: '🎧',
+  async run({ sock, msg, jid, sessionId, args, reply }) {
+    const usage = `🎧 *Video / Voice → MP3*\nReply to a video, voice note or audio with ${PREFIX}tomp3 (or send it with ${PREFIX}tomp3 as the caption).\n${PREFIX}tomp3 doc = send the MP3 as a file.\nUp to ${Math.round(MAX_AUDIO_SECONDS / 60)} minutes and ${MB(MAX_INPUT_BYTES)} MB.`;
+    const media = findMedia(msg, jid);
+    if (!media) return reply(usage);
+    if (media.kind !== 'video' && media.kind !== 'audio') return reply(`That is not a video or audio.\n${usage}`);
+    if (sizeOf(media.part) > MAX_INPUT_BYTES) return reply(failText({ tooBig: true }));
+    if (tooSoon(`mp3|${whoKey(sessionId, jid, msg)}`, 4000)) return reply('⏳ One at a time please. Try again in a few seconds.');
+    try {
+      const input = await downloadMedia(sock, media);
+      if (input.length > 4 * 1048576) reply('⏳ Converting to MP3…').catch(() => {});
+      const mp3 = await toMp3(input);
+      const asFile = /^(doc|file|document)$/i.test(args[0] || '');
+      if (asFile) {
+        const base = String(media.part.fileName || '').replace(/\.[^.]{1,5}$/, '').replace(/[^\p{L}\p{N} _.-]/gu, '').trim().slice(0, 40) || 'RioXMD-audio';
+        return await sock.sendMessage(jid, { document: mp3, mimetype: 'audio/mpeg', fileName: `${base}.mp3` }, { quoted: msg });
+      }
+      return await sock.sendMessage(jid, { audio: mp3, mimetype: 'audio/mpeg', ptt: false }, { quoted: msg });
+    } catch (err) {
+      console.error('tomp3 error:', err?.message || err);
+      return reply(failText(err));
+    }
+  },
+};
+
+/* ---------- .topdf ---------- */
+// WhatsApp commands see one message at a time, so photos are collected per person:
+//   .topdf (with a photo)  adds a page      .topdf done [name]  makes the PDF      .topdf now  = add this photo and make the PDF
+//   .topdf clear           starts again     .topdf status       shows the page count
+// Pages wait in memory for 20 minutes. Limits: pages per PDF (TOPDF_MAX_PAGES, default 20), 20 MB per person, 80 MB for everybody.
+const STACK_TTL_MS = 20 * 60e3;
+const MAX_STACK_BYTES = 20 * 1048576;
+const MAX_ALL_BYTES = 80 * 1048576;
+export const stacks = new Map(); // key -> { pages: [{ jpeg, width, height }], bytes, at }
+setInterval(() => { const t = Date.now(); for (const [k, s] of stacks) if (t - s.at > STACK_TTL_MS) stacks.delete(k); }, 60e3).unref();
+const allBytes = () => { let n = 0; for (const s of stacks.values()) n += s.bytes; return n; };
+
+// Photos from one person are handled in the order their commands arrived.
+const chains = new Map();
+function serial(key, fn) {
+  const next = (chains.get(key) || Promise.resolve()).catch(() => {}).then(fn);
+  chains.set(key, next);
+  next.catch(() => {}).finally(() => { if (chains.get(key) === next) chains.delete(key); });
+  return next;
+}
+
+const DONE = new Set(['done', 'make', 'finish', 'create', 'go', 'send']);
+const CLEAR = new Set(['clear', 'reset', 'cancel', 'stop']);
+const STATUS = new Set(['status', 'list', 'pages', 'count']);
+
+export function pdfName(words) {
+  const base = words.join(' ').replace(/\.pdf$/i, '').replace(/[^\p{L}\p{N} _-]/gu, '').trim().replace(/\s+/g, '_').slice(0, 40);
+  return base || `RioXMD-${new Date().toISOString().slice(0, 10)}`;
+}
+
+const topdf = {
+  name: 'topdf', aliases: ['pdf', 'imgtopdf'], react: '📄',
+  async run({ sock, msg, jid, sessionId, args, reply }) {
+    const key = whoKey(sessionId, jid, msg);
+    const sub = (args[0] || '').toLowerCase();
+    const usage = [
+      '📄 *Photos → PDF*',
+      `1) Reply to a photo with ${PREFIX}topdf (or send the photo with ${PREFIX}topdf as the caption). Do it for each photo, one at a time, up to ${MAX_PDF_PAGES}.`,
+      `2) Send ${PREFIX}topdf done  (or ${PREFIX}topdf done MyNotes to name the file).`,
+      `Only one photo? Use ${PREFIX}topdf now.`,
+      `${PREFIX}topdf clear = start again · ${PREFIX}topdf status = pages so far`,
+    ].join('\n');
+
+    if (CLEAR.has(sub)) {
+      const had = stacks.get(key)?.pages.length || 0;
+      stacks.delete(key);
+      return reply(had ? `🗑️ Cleared ${had} page(s). Start again with a photo.` : 'Nothing to clear. Send a photo with the command to start.');
+    }
+    if (STATUS.has(sub)) {
+      const n = stacks.get(key)?.pages.length || 0;
+      return reply(n ? `📄 ${n} page(s) waiting. Add more, or send ${PREFIX}topdf done` : usage);
+    }
+
+    return serial(key, async () => {
+      const wantsDone = DONE.has(sub);
+      const now = sub === 'now';
+      let media = findMedia(msg, jid);
+      if (wantsDone && stacks.get(key)?.pages.length) media = null; // "done" only finishes: it does not add the photo it replies to
+      const nameWords = args.slice(wantsDone || now ? 1 : 0);
+
+      if (media) {
+        if (media.kind !== 'image') return reply(`🖼️ ${PREFIX}topdf works with photos only.\n${usage}`);
+        if (sizeOf(media.part) > MAX_INPUT_BYTES) return reply(failText({ tooBig: true }));
+        const st = stacks.get(key);
+        if (st && st.pages.length >= MAX_PDF_PAGES) return reply(`📄 That is already ${MAX_PDF_PAGES} pages (the limit). Send ${PREFIX}topdf done to get the PDF.`);
+        if (allBytes() > MAX_ALL_BYTES) return reply('⏳ The server is busy with other PDFs right now. Try again in a few minutes.');
+        let page;
+        try {
+          page = await imageToPage(await downloadMedia(sock, media));
+        } catch (err) {
+          console.error('topdf error:', err?.message || err);
+          return reply(failText(err));
+        }
+        const cur = stacks.get(key) || { pages: [], bytes: 0, at: Date.now() };
+        if (cur.bytes + page.jpeg.length > MAX_STACK_BYTES) return reply(`📄 Those pages are already ${MB(MAX_STACK_BYTES)} MB. Send ${PREFIX}topdf done to get the PDF, then start a new one.`);
+        cur.pages.push(page);
+        cur.bytes += page.jpeg.length;
+        cur.at = Date.now();
+        stacks.set(key, cur);
+        if (!now && !wantsDone) {
+          return reply(`📄 Page *${cur.pages.length}* added.\nSend the next photo with ${PREFIX}topdf, or ${PREFIX}topdf done to get the PDF.`);
+        }
+      }
+
+      const st = stacks.get(key);
+      if (!(wantsDone || now)) return reply(st?.pages.length ? `📄 ${st.pages.length} page(s) waiting. Send a photo with ${PREFIX}topdf to add one, or ${PREFIX}topdf done` : usage);
+      if (!st?.pages.length) return reply(usage);
+
+      try {
+        const name = pdfName(nameWords);
+        const pdf = buildPdf(st.pages, { title: name });
+        await sock.sendMessage(jid, { document: pdf, mimetype: 'application/pdf', fileName: `${name}.pdf`, caption: `📄 PDF ready: ${st.pages.length} page(s)` }, { quoted: msg });
+        stacks.delete(key);
+      } catch (err) {
+        console.error('topdf build error:', err?.message || err);
+        return reply('❌ Could not make the PDF. Your pages are still saved: try again, or ' + `${PREFIX}topdf clear to start over.`);
+      }
+    });
+  },
+};
+
+/* ---------- .ocr ---------- */
+const OCR_MAX_CHARS = Math.max(500, Number(process.env.OCR_MAX_CHARS || 4000));
+const ocr = {
+  name: 'ocr', aliases: ['totext', 'imgtext'], react: '🔠',
+  async run({ sock, msg, jid, sessionId, args, reply }) {
+    const usage = [
+      '🔠 *Photo → Text (OCR)*',
+      `Reply to a photo with ${PREFIX}ocr (or send the photo with ${PREFIX}ocr as the caption).`,
+      `Languages: ${PREFIX}ocr si (Sinhala) · ${PREFIX}ocr en (English) · ${PREFIX}ocr ta (Tamil) · ${PREFIX}ocr si+en. Default is Sinhala + English.`,
+      'Clear, straight, well lit pictures work best. Sinhala is less accurate than English, so check the result.',
+    ].join('\n');
+    let langs = DEFAULT_OCR_LANGS;
+    if (args[0]) {
+      langs = parseOcrLang(args[0]);
+      if (!langs) return reply(`❔ I do not know the language "${args[0].slice(0, 20)}".\n${usage}`);
+    }
+    const media = findMedia(msg, jid);
+    if (!media) return reply(usage);
+    if (media.kind !== 'image') return reply(`🖼️ ${PREFIX}ocr works with photos only.\n${usage}`);
+    if (sizeOf(media.part) > MAX_INPUT_BYTES) return reply(failText({ tooBig: true }));
+    if (tooSoon(`ocr|${whoKey(sessionId, jid, msg)}`, 6000)) return reply('⏳ One at a time please. Try again in a few seconds.');
+    try {
+      const input = await downloadMedia(sock, media);
+      reply('⏳ Reading the text…').catch(() => {});
+      const { text, skipped } = await ocrImage(input, langs);
+      if (skipped.length) await reply(`⚠️ ${skipped.map((l) => OCR_NAMES[l] || l).join(' / ')} language data is not installed on this server, so it was skipped.`).catch(() => {});
+      if (!text) return await reply('🔍 No text found in that picture. Try a clearer, closer photo.');
+      const cut = text.length > OCR_MAX_CHARS;
+      // Sent exactly as read (no bold, no footer) so it can be copied.
+      return await say(sock, jid, cut ? `${text.slice(0, OCR_MAX_CHARS)}\n…` : text, msg, { raw: true });
+    } catch (err) {
+      console.error('ocr error:', err?.message || err);
+      return reply(failText(err));
+    }
+  },
+};
+
+export default [tomp3, topdf, ocr];
diff -ruN -x node_modules -x sessions -x package-lock.json orig/rioxmd-main/commands/webtools.js rioxmd-main/commands/webtools.js
--- a/commands/webtools.js	1970-01-01 00:00:00.000000000 +0000
+++ b/commands/webtools.js	2026-11-05 12:22:12.408800544 +0000
@@ -0,0 +1,150 @@
+// Web tools.
+//   .short <link>   (aliases .shorten .shorturl)   short link (is.gd, then TinyURL if is.gd is down)
+//   .ss <link>      (aliases .screenshot .ssweb)   screenshot of a web page.  .ss <link> full = the whole page, not only the top
+// Both take the link after the command or from the message that was replied to.
+// The screenshot is made by an outside service (thum.io, then Microlink), so this server never opens the page itself.
+// Optional env: SCREENSHOT_URL = your own screenshot service; write {url} where the encoded page address goes.
+import { PREFIX } from '../lib/config.js';
+import { createLimiter } from '../lib/mediatools.js';
+import { unwrapMessage } from '../lib/text.js';
+
+const TIMEOUT_MS = 15000;
+const SHOT_TIMEOUT_MS = 50000;
+const MAX_SHOT_BYTES = 8 * 1048576;
+const UA = { 'user-agent': 'RIO-X-MD/1.4 (WhatsApp bot)' };
+
+const lastUse = new Map();
+setInterval(() => { const t = Date.now(); for (const [k, v] of lastUse) if (t - v > 120e3) lastUse.delete(k); }, 5 * 60e3).unref();
+function tooSoon(key, ms) {
+  const now = Date.now();
+  if (now - (lastUse.get(key) || 0) < ms) return true;
+  lastUse.set(key, now);
+  return false;
+}
+const who = (sessionId, msg, jid) => `${sessionId}|${msg.key?.participant || jid}`;
+
+/* ---------- reading the link ---------- */
+const PRIVATE_V4 = /^(0\.|10\.|127\.|169\.254\.|172\.(1[6-9]|2\d|3[01])\.|192\.168\.|100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.)/;
+
+// "example.com/page" or "https://example.com/page" -> a clean https/http address. Anything else (other schemes, logins inside the
+// link, local / private addresses, no dot in the name) -> null.
+export function normalizeUrl(raw) {
+  let s = String(raw || '').trim().replace(/^[<"'(]+|[>"').,;!?]+$/g, '');
+  if (!s || s.length > 2000) return null;
+  if (!/^[a-z][a-z0-9+.-]*:/i.test(s)) {
+    if (!/^[\p{L}\p{N}-]+(\.[\p{L}\p{N}-]+)+(:\d{1,5})?([/?#]|$)/u.test(s)) return null; // a plain word is not a link
+    s = `https://${s}`;
+  }
+  let u;
+  try { u = new URL(s); } catch { return null; }
+  if (u.protocol !== 'http:' && u.protocol !== 'https:') return null;
+  if (u.username || u.password) return null;
+  const host = u.hostname.toLowerCase();
+  if (!host.includes('.') || host.startsWith('[')) return null; // "localhost", IPv6 and one-word hosts
+  if (/\.(local|localhost|internal|lan|home|corp|test|invalid)$/.test(host)) return null;
+  if (/^\d+\.\d+\.\d+\.\d+$/.test(host) && PRIVATE_V4.test(host)) return null;
+  return u.toString();
+}
+
+function quotedText(msg) {
+  const q = unwrapMessage(msg.message).extendedTextMessage?.contextInfo?.quotedMessage;
+  if (!q) return '';
+  const m = unwrapMessage(q);
+  return m.conversation || m.extendedTextMessage?.text || m.imageMessage?.caption || m.videoMessage?.caption || '';
+}
+
+// The link typed after the command, else the first link in the replied-to message.
+function linkFrom(args, msg) {
+  const typed = args.find((a) => normalizeUrl(a));
+  if (typed) return normalizeUrl(typed);
+  const found = quotedText(msg).match(/(?:https?:\/\/|www\.)[^\s<>"']+/i)?.[0];
+  return found ? normalizeUrl(found) : null;
+}
+
+/* ---------- .short ---------- */
+async function isgd(url) {
+  const res = await fetch(`https://is.gd/create.php?${new URLSearchParams({ format: 'json', url })}`, { signal: AbortSignal.timeout(TIMEOUT_MS), headers: UA });
+  const data = await res.json().catch(() => null);
+  if (data?.shorturl) return String(data.shorturl);
+  throw new Error(`is.gd: ${data?.errormessage || `HTTP ${res.status}`}`);
+}
+async function tinyurl(url) {
+  const res = await fetch(`https://tinyurl.com/api-create.php?${new URLSearchParams({ url })}`, { signal: AbortSignal.timeout(TIMEOUT_MS), headers: UA });
+  const text = (await res.text()).trim();
+  if (res.ok && /^https?:\/\/(www\.)?tinyurl\.com\/\S+$/i.test(text)) return text;
+  throw new Error(`tinyurl: HTTP ${res.status}`);
+}
+export async function shorten(url) {
+  const errors = [];
+  for (const svc of [isgd, tinyurl]) {
+    try { return await svc(url); } catch (err) { errors.push(err?.message || String(err)); }
+  }
+  throw new Error(errors.join(' | '));
+}
+
+const short = {
+  name: 'short', aliases: ['shorten', 'shorturl'], react: '🔗',
+  async run({ msg, jid, sessionId, args, reply }) {
+    const url = linkFrom(args, msg);
+    if (!url) return reply(`🔗 *Link shortener*\nUsage: ${PREFIX}short <link>  (or reply to a message that has a link)\nExample: ${PREFIX}short https://example.com/a/very/long/address`);
+    if (tooSoon(`short|${who(sessionId, msg, jid)}`, 3000)) return reply('⏳ Wait a few seconds before the next one.');
+    try {
+      const link = await shorten(url);
+      return await reply(`🔗 *Short link*\n${link}\n\n📎 ${url.length > 70 ? `${url.slice(0, 67)}...` : url}`);
+    } catch (err) {
+      console.error('short error:', err?.message || err);
+      return reply('❌ The link shortener is not answering right now. Try again in a little while.');
+    }
+  },
+};
+
+/* ---------- .ss ---------- */
+const shotLimit = createLimiter(Math.max(1, Number(process.env.MAX_SS_JOBS || 2)));
+
+// Screenshot services, tried in this order. Each gets the page address and returns the address of the picture.
+const providers = (url, full) => [
+  ...(process.env.SCREENSHOT_URL ? [process.env.SCREENSHOT_URL.replace('{url}', encodeURIComponent(url))] : []),
+  `https://image.thum.io/get/${full ? 'fullpage/' : ''}width/1280/noanimate/${url}`,
+  `https://api.microlink.io/?${new URLSearchParams({ url, screenshot: 'true', meta: 'false', embed: 'screenshot.url', 'viewport.width': '1280', 'viewport.height': '800', ...(full ? { 'screenshot.fullPage': 'true' } : {}) })}`,
+];
+
+const isImage = (b) => b.length > 2048 && (
+  (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47) ||                 // PNG
+  (b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) ||                                  // JPEG
+  (b.toString('latin1', 0, 4) === 'RIFF' && b.toString('latin1', 8, 12) === 'WEBP'));  // WebP
+
+export async function screenshot(url, full = false) {
+  const errors = [];
+  for (const endpoint of providers(url, full)) {
+    try {
+      const res = await fetch(endpoint, { signal: AbortSignal.timeout(SHOT_TIMEOUT_MS), headers: UA, redirect: 'follow' });
+      if (!res.ok) throw new Error(`HTTP ${res.status}`);
+      if (Number(res.headers.get('content-length') || 0) > MAX_SHOT_BYTES) throw new Error('picture too big');
+      const buf = Buffer.from(await res.arrayBuffer());
+      if (buf.length > MAX_SHOT_BYTES) throw new Error('picture too big');
+      if (!isImage(buf)) throw new Error('not a picture');
+      return buf;
+    } catch (err) { errors.push(`${new URL(endpoint).host}: ${err?.message || err}`); }
+  }
+  throw new Error(errors.join(' | '));
+}
+
+const ss = {
+  name: 'ss', aliases: ['screenshot', 'ssweb'], react: '📸',
+  async run({ sock, msg, jid, sessionId, args, reply }) {
+    const full = args.some((a) => /^(full|fullpage)$/i.test(a));
+    const url = linkFrom(args.filter((a) => !/^(full|fullpage)$/i.test(a)), msg);
+    if (!url) return reply(`📸 *Website screenshot*\nUsage: ${PREFIX}ss <link>  (or reply to a message that has a link)\n${PREFIX}ss <link> full = the whole page\nExample: ${PREFIX}ss example.com`);
+    if (tooSoon(`ss|${who(sessionId, msg, jid)}`, 10000)) return reply('⏳ One screenshot at a time please. Try again in a few seconds.');
+    reply('⏳ Taking the screenshot… this can take up to a minute.').catch(() => {});
+    try {
+      const image = await shotLimit(() => screenshot(url, full));
+      return await sock.sendMessage(jid, { image, caption: `📸 ${url.length > 120 ? `${url.slice(0, 117)}...` : url}` }, { quoted: msg });
+    } catch (err) {
+      console.error('ss error:', err?.message || err);
+      return reply('❌ Could not take a screenshot of that page. The site may block screenshots, or the service is busy. Try again later.');
+    }
+  },
+};
+
+export default [short, ss];
diff -ruN -x node_modules -x sessions -x package-lock.json orig/rioxmd-main/lib/mediatools.js rioxmd-main/lib/mediatools.js
--- a/lib/mediatools.js	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/mediatools.js	2026-11-05 12:22:32.766904087 +0000
@@ -0,0 +1,249 @@
+// Helpers for commands/mediatools.js:  .tomp3  .topdf  .ocr
+//   findMedia(msg, jid)         the photo / video / audio / document in this message, or in the message it replies to
+//   downloadMedia(sock, media)  Buffer of that media (size checked)
+//   toMp3(buf)                  video / audio / voice note -> MP3          (ffmpeg)
+//   imageToPage(buf)            photo -> { jpeg, width, height } ready for a PDF page   (sharp)
+//   buildPdf(pages, { title })  list of pages -> one PDF Buffer             (plain Node, no extra npm package)
+//   ocrImage(buf, langs)        photo -> text                               (tesseract)
+//
+// Needs ffmpeg and tesseract on the server (both are in the Docker image). Nothing here touches WhatsApp except downloadMedia().
+// User input never reaches a command line: ffmpeg / tesseract only get fixed options and file names made here.
+import { execFile } from 'node:child_process';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { downloadMediaMessage } from '@whiskeysockets/baileys';
+import { logger } from './config.js';
+import { unwrapMessage } from './text.js';
+
+export const MAX_INPUT_BYTES = Math.max(1, Number(process.env.MAX_MEDIA_MB || 30)) * 1024 * 1024; // refuse bigger downloads
+export const MAX_AUDIO_SECONDS = Math.max(30, Number(process.env.MAX_MP3_SECONDS || 1200));        // longer audio is cut here (20 min)
+export const MAX_PDF_PAGES = Math.max(1, Number(process.env.TOPDF_MAX_PAGES || 20));
+const PAGE_MAX_PX = 2400;                                    // longest side of a PDF picture (about A4 at 200 dpi)
+const TESSERACT = () => process.env.TESSERACT_PATH || 'tesseract';
+
+/* ---------- limit how many heavy jobs run together ---------- */
+export function createLimiter(max) {
+  let running = 0;
+  const waiting = [];
+  return async (fn) => {
+    if (running >= max) await new Promise((resolve) => waiting.push(resolve));
+    running++;
+    try { return await fn(); } finally { running--; waiting.shift()?.(); }
+  };
+}
+const limited = createLimiter(Math.max(1, Number(process.env.MAX_MEDIA_JOBS || 2)));
+
+function run(cmd, args, { timeout = 120000, env } = {}) {
+  return new Promise((resolve, reject) => {
+    execFile(cmd, args, { timeout, maxBuffer: 16 * 1024 * 1024, ...(env ? { env: { ...process.env, ...env } } : {}) }, (err, stdout, stderr) => {
+      if (!err) return resolve(String(stdout));
+      if (err.code === 'ENOENT') return reject(Object.assign(new Error(`${cmd} is not installed`), { missing: cmd }));
+      reject(Object.assign(new Error(`${cmd} failed: ${String(stderr || err.message).slice(-300)}`), { stderr: String(stderr || '') }));
+    });
+  });
+}
+
+async function withTmp(fn) {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'rio-mt-'));
+  try { return await fn(dir); } finally { fs.rm(dir, { recursive: true, force: true }).catch(() => {}); }
+}
+
+/* ---------- find + download the media a command works on ---------- */
+// Tests replace deps.download so no real WhatsApp download is needed.
+export const deps = { download: downloadMediaMessage };
+
+const num = (v) => (typeof v?.toNumber === 'function' ? v.toNumber() : Number(v || 0)); // protobuf sizes can be Long objects
+
+function classify(m) {
+  if (m.imageMessage) return { kind: 'image', part: m.imageMessage };
+  if (m.videoMessage) return { kind: 'video', part: m.videoMessage };
+  if (m.audioMessage) return { kind: 'audio', part: m.audioMessage };
+  if (m.documentMessage) { // a file: photos / videos / audio sent "as a file" keep their real kind
+    const mime = String(m.documentMessage.mimetype || '');
+    const kind = mime.startsWith('image/') ? 'image' : mime.startsWith('video/') ? 'video' : mime.startsWith('audio/') ? 'audio' : 'document';
+    return { kind, part: m.documentMessage };
+  }
+  return null;
+}
+
+// The message itself (media + caption), or else the message that was replied to. Returns { kind, part, target } or null.
+export function findMedia(msg, jid) {
+  const own = unwrapMessage(msg.message);
+  const hit = classify(own);
+  if (hit) return { ...hit, target: msg };
+  const ctx = own.extendedTextMessage?.contextInfo;
+  const quoted = ctx?.quotedMessage ? unwrapMessage(ctx.quotedMessage) : null;
+  const q = quoted && classify(quoted);
+  if (!q) return null;
+  return { ...q, target: { key: { remoteJid: jid, id: ctx.stanzaId, participant: ctx.participant, fromMe: false }, message: quoted } };
+}
+
+export async function downloadMedia(sock, media, maxBytes = MAX_INPUT_BYTES) {
+  if (num(media.part.fileLength) > maxBytes) throw Object.assign(new Error('file too big'), { tooBig: true });
+  let buf;
+  try {
+    buf = await deps.download(media.target, 'buffer', {}, { logger, reuploadRequest: sock.updateMediaMessage });
+  } catch (err) {
+    throw Object.assign(new Error(`download failed: ${err?.message || err}`), { download: true });
+  }
+  if (!buf?.length) throw Object.assign(new Error('empty download'), { download: true });
+  if (buf.length > maxBytes) throw Object.assign(new Error('file too big'), { tooBig: true });
+  return buf;
+}
+
+/* ---------- .tomp3 ---------- */
+export function toMp3(input) {
+  return limited(() => withTmp(async (dir) => {
+    const inFile = path.join(dir, 'in.bin');
+    const outFile = path.join(dir, 'out.mp3');
+    await fs.writeFile(inFile, input);
+    try {
+      await run('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-nostdin', '-y', '-i', inFile, '-vn', '-map', '0:a:0', '-map_metadata', '-1',
+        '-ac', '2', '-ar', '44100', '-c:a', 'libmp3lame', '-b:a', '128k', '-t', String(MAX_AUDIO_SECONDS), outFile], { timeout: 240000 });
+    } catch (err) {
+      if (/matches no streams|does not contain any stream|Stream map/i.test(err.stderr || err.message)) throw Object.assign(err, { noAudio: true });
+      throw err;
+    }
+    const out = await fs.readFile(outFile);
+    if (!out.length) throw Object.assign(new Error('empty mp3'), { noAudio: true });
+    return out;
+  }));
+}
+
+/* ---------- .topdf ---------- */
+let sharpMod;
+const getSharp = async () => (sharpMod ||= (await import('sharp')).default);
+
+// Photo -> JPEG (turned upright, transparent parts white, 3 colour channels, at most PAGE_MAX_PX on the long side).
+export function imageToPage(input) {
+  return limited(async () => {
+    const sharp = await getSharp();
+    try {
+      const { data, info } = await sharp(input, { failOn: 'none', limitInputPixels: 80e6 })
+        .rotate()
+        .resize(PAGE_MAX_PX, PAGE_MAX_PX, { fit: 'inside', withoutEnlargement: true })
+        .flatten({ background: '#ffffff' })
+        .toColourspace('srgb')
+        .jpeg({ quality: 85 })
+        .toBuffer({ resolveWithObject: true });
+      return { jpeg: data, width: info.width, height: info.height };
+    } catch (err) {
+      throw Object.assign(new Error(`unreadable image: ${err?.message || err}`), { badImage: true });
+    }
+  });
+}
+
+const A4 = [595.28, 841.89];
+const MARGIN = 24;
+const MAX_PAGE_UNITS = 14400; // PDF viewers refuse pages bigger than this
+
+// Where the picture goes on its page. Normal photos: A4 (upright or sideways), centred with a small margin.
+// Very long / very wide pictures (chat screenshots, banners): the page takes the shape of the picture instead of a tiny strip on A4.
+export function pageLayout(w, h) {
+  const ratio = h / w;
+  if (ratio > 1.9 || ratio < 0.52) {
+    let pw = A4[0];
+    let ph = pw * ratio;
+    if (ph > MAX_PAGE_UNITS) { ph = MAX_PAGE_UNITS; pw = ph / ratio; }
+    return { pw, ph, x: 0, y: 0, dw: pw, dh: ph };
+  }
+  const landscape = w > h;
+  const pw = landscape ? A4[1] : A4[0];
+  const ph = landscape ? A4[0] : A4[1];
+  const s = Math.min((pw - 2 * MARGIN) / w, (ph - 2 * MARGIN) / h);
+  const dw = w * s;
+  const dh = h * s;
+  return { pw, ph, x: (pw - dw) / 2, y: (ph - dh) / 2, dw, dh };
+}
+
+const f2 = (n) => Number(n).toFixed(2);
+
+// One PDF with one picture per page. pages = [{ jpeg: Buffer, width, height }]
+export function buildPdf(pages, { title = '' } = {}) {
+  if (!pages?.length) throw new Error('no pages');
+  const parts = [];
+  const offsets = [];
+  let size = 0;
+  const push = (b) => { const buf = Buffer.isBuffer(b) ? b : Buffer.from(b, 'latin1'); parts.push(buf); size += buf.length; };
+  const obj = (n, body) => { offsets[n] = size; push(`${n} 0 obj\n${body}\nendobj\n`); };
+  const streamObj = (n, dict, data) => {
+    offsets[n] = size;
+    push(`${n} 0 obj\n<< ${dict} /Length ${data.length} >>\nstream\n`);
+    push(data);
+    push('\nendstream\nendobj\n');
+  };
+
+  const kids = pages.map((_, i) => `${4 + 3 * i} 0 R`).join(' ');
+  const safeTitle = String(title).replace(/[^\x20-\x7e]/g, '').replace(/[()\\]/g, '').slice(0, 80);
+  const date = new Date().toISOString().replace(/[-:T]/g, '').slice(0, 14);
+
+  push(Buffer.from([0x25, 0x50, 0x44, 0x46, 0x2d, 0x31, 0x2e, 0x34, 0x0a, 0x25, 0xe2, 0xe3, 0xcf, 0xd3, 0x0a])); // %PDF-1.4 + binary marker
+  obj(1, '<< /Type /Catalog /Pages 2 0 R >>');
+  obj(2, `<< /Type /Pages /Kids [${kids}] /Count ${pages.length} >>`);
+  obj(3, `<< /Producer (RIO X MD)${safeTitle ? ` /Title (${safeTitle})` : ''} /CreationDate (D:${date}Z) >>`);
+  pages.forEach((p, i) => {
+    if (p.jpeg[0] !== 0xff || p.jpeg[1] !== 0xd8) throw new Error('page is not a JPEG');
+    const L = pageLayout(p.width, p.height);
+    const page = 4 + 3 * i;
+    obj(page, `<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${f2(L.pw)} ${f2(L.ph)}] /Resources << /XObject << /Im0 ${page + 2} 0 R >> >> /Contents ${page + 1} 0 R >>`);
+    streamObj(page + 1, '', Buffer.from(`q ${f2(L.dw)} 0 0 ${f2(L.dh)} ${f2(L.x)} ${f2(L.y)} cm /Im0 Do Q`, 'latin1'));
+    streamObj(page + 2, `/Type /XObject /Subtype /Image /Width ${p.width} /Height ${p.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode`, p.jpeg);
+  });
+
+  const count = 4 + 3 * pages.length - 1; // objects 1 .. count
+  const xref = size;
+  let table = `xref\n0 ${count + 1}\n0000000000 65535 f \n`;
+  for (let n = 1; n <= count; n++) table += `${String(offsets[n]).padStart(10, '0')} 00000 n \n`;
+  push(`${table}trailer\n<< /Size ${count + 1} /Root 1 0 R /Info 3 0 R >>\nstartxref\n${xref}\n%%EOF\n`);
+  return Buffer.concat(parts);
+}
+
+/* ---------- .ocr ---------- */
+export const DEFAULT_OCR_LANGS = ['sin', 'eng'];
+const OCR_WORDS = { en: 'eng', eng: 'eng', english: 'eng', si: 'sin', sin: 'sin', sinhala: 'sin', ta: 'tam', tam: 'tam', tamil: 'tam' };
+export const OCR_NAMES = { eng: 'English', sin: 'Sinhala', tam: 'Tamil' };
+
+// "si" / "en" / "si+en" -> ['sin'] / ['eng'] / ['sin','eng'].  Anything that is not a language word -> null.
+export function parseOcrLang(word) {
+  const parts = String(word || '').toLowerCase().split(/[+,]/).filter(Boolean);
+  if (!parts.length || parts.some((p) => !OCR_WORDS[p])) return null;
+  return [...new Set(parts.map((p) => OCR_WORDS[p]))];
+}
+
+let langCache = null; // Promise<Set<string>>
+export function ocrLangs() {
+  langCache ||= run(TESSERACT(), ['--list-langs'], { timeout: 15000 })
+    .then((out) => new Set(out.split('\n').slice(1).map((l) => l.trim()).filter(Boolean)))
+    .catch((err) => { langCache = null; throw err; }); // not installed now, maybe later: do not remember a failure
+  return langCache;
+}
+export const resetOcrLangs = () => { langCache = null; };
+
+// Cleans what tesseract printed: no form feeds, no trailing spaces, no more than one empty line in a row.
+export function cleanOcrText(text) {
+  return String(text || '').replace(/\f/g, '').replace(/\r/g, '').replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
+}
+
+// Returns { text, langs, skipped }. langs = what was used; skipped = wanted languages that are not installed on this server.
+export async function ocrImage(input, wanted = DEFAULT_OCR_LANGS) {
+  const have = await ocrLangs();
+  const langs = wanted.filter((l) => have.has(l));
+  const skipped = wanted.filter((l) => !have.has(l));
+  if (!langs.length) throw Object.assign(new Error('language data missing'), { noLang: skipped });
+  const sharp = await getSharp();
+  return limited(() => withTmp(async (dir) => {
+    const inFile = path.join(dir, 'in.png');
+    try {
+      const meta = await sharp(input, { failOn: 'none', limitInputPixels: 80e6 }).metadata();
+      const width = meta.width || 0;
+      const target = width < 1200 ? 1600 : width > 3200 ? 3200 : width; // tiny photos are enlarged, huge ones shrunk: tesseract likes about 300 dpi
+      await sharp(input, { failOn: 'none', limitInputPixels: 80e6 }).rotate().flatten({ background: '#ffffff' }).grayscale().normalise()
+        .resize({ width: target, withoutEnlargement: false }).png().toFile(inFile);
+    } catch (err) {
+      throw Object.assign(new Error(`unreadable image: ${err?.message || err}`), { badImage: true });
+    }
+    const out = await run(TESSERACT(), [inFile, 'stdout', '-l', langs.join('+'), '--dpi', '300'], { timeout: 120000, env: { OMP_THREAD_LIMIT: '1' } });
+    return { text: cleanOcrText(out), langs, skipped };
+  }));
+}
