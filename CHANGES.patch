+test('buildPdf: valid structure, every xref offset points at its object', async () => {
+  const pdf = lib.buildPdf([await jpegPage(300, 400), await jpegPage(400, 300, '#aa3333'), await jpegPage(200, 1200)], { title: 'My Notes (1)' });
